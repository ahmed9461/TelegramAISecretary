[Unit]
Description=Telegram AI Secretary API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secretary
Group=secretary
WorkingDirectory=/opt/telegram-ai-secretary
EnvironmentFile=/opt/telegram-ai-secretary/.env
ExecStart=/opt/telegram-ai-secretary/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
