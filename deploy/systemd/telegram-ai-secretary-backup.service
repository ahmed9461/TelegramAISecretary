[Unit]
Description=Telegram AI Secretary PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=secretary
Group=secretary
WorkingDirectory=/opt/telegram-ai-secretary
EnvironmentFile=/opt/telegram-ai-secretary/.env
ExecStart=/opt/telegram-ai-secretary/.venv/bin/python -m scripts.backup_postgres --output-dir /var/backups/telegram-ai-secretary
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/telegram-ai-secretary
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
