[Unit]
Description=Telegram AI Secretary Bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=secretary
Group=secretary
WorkingDirectory=/opt/telegram-ai-secretary
EnvironmentFile=/opt/telegram-ai-secretary/.env
ExecStart=/opt/telegram-ai-secretary/.venv/bin/python -m app.telegram.run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
