APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_HOST_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
# Required in production; generate a random value of at least 32 characters.
METRICS_TOKEN=
METRICS_WINDOW_DAYS=30
READINESS_REQUIRE_TELEGRAM=true
READINESS_REQUIRE_AI=true
BACKUP_RETENTION_DAYS=30

TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
TELEGRAM_POLLING=true

# Local PostgreSQL (Docker binds to localhost only)
POSTGRES_DB=secretary
POSTGRES_USER=secretary
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://secretary:change-me@127.0.0.1:5433/secretary

# Stability / context
APPROVAL_TTL_HOURS=24
MESSAGE_DEBOUNCE_SECONDS=1.5
CONTEXT_MESSAGE_LIMIT=12
KNOWLEDGE_TOP_K=6
MEMORY_RETENTION_DAYS=365
MEMORY_SUGGESTION_TTL_HOURS=72
FEEDBACK_BUTTONS_ENABLED=true
FEEDBACK_PROMPT_EVERY_N_RESPONSES=3
CUSTOM_INTENT_DEFAULT_THRESHOLD=0.82
SCHEDULE_POLL_SECONDS=30
SCHEDULE_BATCH_SIZE=20
SCHEDULE_CLAIM_TIMEOUT_SECONDS=300

# Text reasoning / reply model
AI_PROVIDER=deepseek
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=1.0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false

# Image understanding model
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1.0
MAX_IMAGE_BYTES=10000000
MAX_MEDIA_BYTES=18000000

# Reserved for a future optional provider
OPENAI_API_KEY=
OPENAI_MODEL=
